{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "ro-idle-remote",
  "description": "Lets the hosted game page emit character events to the tray. Emit only.",
  "windows": ["game-*"],
  "remote": {
    "urls": ["https://ro-idle.app", "https://ro-idle.app/*"]
  },
  "permissions": ["core:event:allow-emit"]
}
