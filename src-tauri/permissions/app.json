{
  "permission": [
    {
      "identifier": "panel-commands",
      "description": "Local tray controls, settings and assistant.",
      "commands": {
        "allow": [
          "get_state", "open_account", "toggle_idle", "enter_character",
          "add_account", "remove_account", "set_login", "update_app",
          "open_export_folder", "open_atlas", "open_classes", "set_nickname", "set_goal", "get_groups", "set_groups",
          "reorder_profiles", "set_panel_width", "set_pinned", "hide_panel", "profile_menu", "toggle_online", "refresh_all", "recall_all", "apply_stats", "open_guide", "open_items",
          "ai_get_settings", "ai_save_settings", "ai_list_models", "ai_test_connection",
          "chat_history", "chat_send", "chat_new", "chat_memory", "chat_tutorial", "quit",
          "chat_character", "chat_alerts", "chat_alert_open", "chat_alert_ack", "chat_plan", "chat_plan_set"
        ]
      }
    },
    {
      "identifier": "game-commands",
      "description": "Character reports and the assistant launcher; handlers validate the calling game profile.",
      "commands": {
        "allow": ["character_report", "chat_alerts", "chat_tutorial", "chat_open_panel"]
      }
    },
    {
      "identifier": "atlas-commands",
      "description": "Map explorer character list and movement.",
      "commands": {"allow": ["atlas_characters", "move_all", "move_selected"]}
    },
    {
      "identifier": "items-commands",
      "description": "Item settings editor: merge, edit and fan out every character's item settings.",
      "commands": {"allow": ["items_merge", "items_read", "items_save", "items_apply", "items_characters"]}
    }
  ]
}
